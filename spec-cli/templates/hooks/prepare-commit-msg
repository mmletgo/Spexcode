#!/usr/bin/env bash
# spexcode-managed-hook-v1
# @@@ session-stamp - auto-attribute a commit to the SESSION that authored it, ACROSS HARNESSES. SpexCode
# reads the `Session:` trailer as a version's attribution (git is the database), keyed by the SpexCode record
# id so the dashboard's session window links to it.
#
# The id is simply READ here, because it was established where it is KNOWN: whoever creates an agent's
# execution context injects that context's own record id, and nothing else may carry one.
#   - a session launch bakes `SPEXCODE_SESSION_ID=<record id>` into the agent's process — and STRIPS every
#     session-identity variable it inherited first, so the pane's ancestry (a tmux server started long ago by
#     someone else) cannot smuggle one in;
#   - a codex thread gets the same variable injected into every command it spawns, at `thread/start`, via
#     codex's own `shell_environment_policy.set` — the tool shell is a child of the SHARED app-server and must
#     therefore inherit nothing, so the backend hands it its identity per thread instead;
#   - that shared app-server, and any other process we own that belongs to no single session, is spawned with
#     those variables stripped. A process that outlived its session handing its id to strangers is exactly how
#     this trailer once named a session that no longer existed (github#76).
# So there is nothing to resolve, alias, or verify at commit time: the variable is present only in processes
# that genuinely belong to that session, and it already IS the record id. No store lookup, no per-harness
# tiers, and nothing derived from the current directory — where a process stands says nothing about who it is.
# No id → no trailer. An existing Session: trailer is left alone, so the ritual / a human can set one by hand.
set -euo pipefail
# @@@ trusted sync tool - internal coordinator binding, never candidate.bin or a source launcher.
spex_strict=0
spex_validate_trusted() {
  NODE_OPTIONS= NODE_PATH= LD_PRELOAD= DYLD_INSERT_LIBRARIES= "$SPEXCODE_SYNC_NODE" -e 'const fs=require("node:fs"),p=require("node:path"),c=require("node:crypto");
const h=b=>c.createHash("sha256").update(b).digest("hex"),e=process.env;
const root=fs.realpathSync(e.SPEXCODE_SYNC_RUNTIME_ROOT),entries=[];
const visit=dir=>{for(const name of fs.readdirSync(dir).sort()){
 const file=p.join(dir,name),s=fs.lstatSync(file),local=p.relative(root,file).split(p.sep).join("/");
 if(s.isSymbolicLink()){const target=fs.realpathSync(file);if(target!==root&&!target.startsWith(root+p.sep))throw Error("external runtime symlink");entries.push({path:local,kind:"symlink",mode:s.mode&511,target:fs.readlinkSync(file)});}
 else if(s.isDirectory()){entries.push({path:local,kind:"directory",mode:s.mode&511});visit(file);}
 else if(s.isFile())entries.push({path:local,kind:"file",mode:s.mode&511,digest:h(fs.readFileSync(file))});
 else throw Error("unsupported runtime file");
}};visit(root);
for(const [file,expected] of [[e.SPEXCODE_SYNC_NODE,e.SPEXCODE_SYNC_NODE_SHA256],[e.SPEXCODE_SYNC_GIT,e.SPEXCODE_SYNC_GIT_SHA256],[e.SPEXCODE_SYNC_TOOL,e.SPEXCODE_SYNC_TOOL_SHA256]])
 if(!p.isAbsolute(file)||h(fs.readFileSync(file))!==expected)throw Error("trusted executable digest mismatch");
if(h(JSON.stringify(entries))!==e.SPEXCODE_SYNC_RUNTIME_SHA256)throw Error("trusted runtime digest mismatch");
import(require("node:url").pathToFileURL(p.join(p.dirname(e.SPEXCODE_SYNC_TOOL),"sync/trusted-footprint.js")).href)
 .then(m=>m.frozenFootprintFromEnv(e.SPEXCODE_SYNC_GIT,process.cwd()))
 .catch(error=>{console.error("trusted frozen footprint binding unavailable or changed: "+error.message);process.exitCode=1;});'
}
if [ -n "${SPEXCODE_SYNC_HOOK_MODE:-}" ]; then
  if [ "$SPEXCODE_SYNC_HOOK_MODE" != trusted-v1 ] || [ -z "${SPEXCODE_SYNC_NODE:-}" ] || [ -z "${SPEXCODE_SYNC_TOOL:-}" ] || [ -z "${SPEXCODE_SYNC_GIT:-}" ] || ! spex_validate_trusted; then
    echo "✗ SpexCode: trusted sync tool binding unavailable or changed; delivery refused." >&2
    exit 1
  fi
  case "${SPEXCODE_SYNC_OPERATION:-}" in prepare|publish) ;; *)
    echo "✗ SpexCode: trusted sync operation unavailable; delivery refused." >&2
    exit 1 ;;
  esac
  spex_strict=1
  export GIT_NO_REPLACE_OBJECTS=1
  git() { "$SPEXCODE_SYNC_GIT" --no-replace-objects "$@"; }
fi
msg_file="$1"
if ! grep -qiE '^Session:[[:space:]]' "$msg_file" && [ -n "${SPEXCODE_SESSION_ID:-}" ]; then

# Stamp via interpret-trailers (git's own sample-hook mechanism), NOT a raw printf append: appending after a
# message that already carries a trailer block (e.g. `spex spec ack`'s Spec-OK) opens a new paragraph, and git then
# parses ONLY the last paragraph as trailers — the earlier trailers silently become body prose. interpret-trailers
# appends into the existing block, keeping ONE parseable block. It needs the file newline-terminated first:
# on an unterminated message (git merge -m writes MERGE_MSG without one) it folds the trailer into the subject
# paragraph, where git's trailer parser never looks — the reason merge commits' Session: never parsed.
[ -n "$(tail -c1 "$msg_file")" ] && echo >> "$msg_file"
git interpret-trailers --in-place --trailer "Session: $SPEXCODE_SESSION_ID" "$msg_file"
fi

# @@@ commit context - one spex (the project's install, else PATH; [[main-guard]]). Capture first, print
# successful context verbatim, and report one advisory line for a resolved CLI that fails. An unresolved
# CLI stays silent so an uninstalled adopter does not acquire commit noise.
repo_root=$(git rev-parse --show-toplevel 2>/dev/null)
spex_kind=
if [ "$spex_strict" -eq 1 ]; then
  spex_kind=trusted
elif [ -x "$repo_root/node_modules/.bin/spex" ]; then
  spex_kind=local
elif command -v spex >/dev/null 2>&1; then
  spex_kind=path
fi
spex_cli() {
  case "$spex_kind" in
    trusted) spex_validate_trusted && NODE_OPTIONS= NODE_PATH= "$SPEXCODE_SYNC_NODE" "$SPEXCODE_SYNC_TOOL" "$@" ;;
    path)  spex "$@" ;;
    local) "$repo_root/node_modules/.bin/spex" "$@" ;;
    *)     return 127 ;;
  esac
}

if context=$(spex_cli internal commit-context "$msg_file" 2>&1); then
  [ -z "$context" ] || printf '%s\n' "$context" >&2
elif [ "$spex_strict" -eq 1 ]; then
  printf "✗ SpexCode: trusted commit context failed; delivery refused\n" >&2
  exit 1
elif [ -n "$spex_kind" ]; then
  first_line=${context%%$'\n'*}
  [ -n "$first_line" ] || first_line='unknown error'
  printf '• SpexCode: commit context unavailable (%s) — advisory, commit proceeds\n' "$first_line" >&2
fi
exit 0
